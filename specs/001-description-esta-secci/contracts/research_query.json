{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cero-dolor/contracts/research_query.json",
  "title": "ResearchQuery",
  "type": "object",
  "required": ["requester_id", "criteria", "requested_fields", "compensation_sol"],
  "properties": {
    "requester_id": { "type": "string", "minLength": 1 },
    "criteria": {
      "type": "object",
      "properties": {
        "age_min": { "type": "integer", "minimum": 0, "maximum": 120 },
        "age_max": { "type": "integer", "minimum": 0, "maximum": 120 },
        "gender": { "type": "string", "enum": ["female", "male", "other", "unspecified"] },
        "diagnosis": { "type": "string" }
      },
      "additionalProperties": true
    },
    "requested_fields": {
      "type": "array",
      "items": { "type": "string", "enum": ["activity", "sleep", "pain_summaries"] },
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true
    },
    "compensation_sol": { "type": "number", "minimum": 0 }
  },
  "additionalProperties": false
}
