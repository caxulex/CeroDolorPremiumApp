{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "physio_to_patient.schema.json",
  "title": "PhysioToPatient",
  "description": "Plan de ejercicios del agente fisioterapeuta hacia el paciente.",
  "type": "object",
  "required": ["message_type", "patient_id", "timestamp", "exercise_plan"],
  "properties": {
    "message_type": { "const": "exercise_plan" },
    "patient_id": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "format": "date-time" },
    "exercise_plan": {
      "type": "object",
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "repetitions"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "enum": ["gentle_stretching", "short_walk", "stretch", "walk"] },
              "repetitions": { "type": "integer", "minimum": 1 },
              "frequency_per_day": { "type": "integer", "minimum": 1 },
              "notes": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}