{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cero-dolor/contracts/data_offer.json",
  "title": "DataOffer",
  "type": "object",
  "required": ["patient_id", "wallet_address", "fields", "anonymized_hash"],
  "properties": {
    "patient_id": { "type": "string", "minLength": 1 },
    "wallet_address": { "type": "string", "minLength": 10 },
    "fields": {
      "type": "array",
      "items": { "type": "string", "enum": ["activity", "sleep", "pain_summaries"] },
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true
    },
    "anonymized_hash": { "type": "string", "minLength": 16 }
  },
  "additionalProperties": false
}
