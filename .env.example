# Copy to .env and fill actual secrets; docker-compose will load it automatically
# Coral Server
CORAL_SERVER_URL=http://coral-server:5555

# External APIs
MISTRAL_API_KEY=replace-with-mistral-key
ELEVENLABS_API_KEY=replace-with-elevenlabs-key

# Runtime switches
USE_NETWORK=false
## MCP server and tool path defaults (used by backend MCP client/shim)
MCP_BASE_URL=http://localhost:3000
MCP_HEALTH_PATH=/health
MCP_ECHO_PATH=/echo
MCP_TOOL_AIP_TO_ASD_PATH=/echo
MCP_TOOL_ASD_TO_AIPER_PATH=/echo

## Network/Adapters toggles (default offline for CI stability)
# Set to "true" to allow network calls in adapters (Crossmint/Solana/etc.)
USE_NETWORK=false
# Enable adapter usage in services (still offline unless USE_NETWORK=true)
USE_ADAPTERS=true

## External APIs (opt-in)
# ElevenLabs / Mistral (placeholders here, not used in this patch)
ELEVENLABS_API_KEY=
MISTRAL_API_KEY=
USE_MISTRAL=

## Crossmint integration (env-gated)
# If USE_NETWORK=true and CROSSMINT_API_KEY is set, network calls will be attempted
CROSSMINT_API_KEY=
# Optional base URL override (defaults to https://www.crossmint.com/api/)
CROSSMINT_BASE_URL=
# Optional collection id when minting
CROSSMINT_COLLECTION_ID=

## Solana integration (env-gated)
# If USE_NETWORK=true and SOLANA_RPC_URL (+ optionally SOLANA_PAYER_SECRET) are set,
# minimal RPC calls (e.g., getLatestBlockhash) will be attempted
SOLANA_RPC_URL=
SOLANA_PAYER_SECRET=
